<resources>
    <style name="Theme.DSHMobile" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/surface_alt</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border</item>
        <item name="colorSurfaceVariant">@color/surface_alt</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- 状态栏处理改为在 Activity 里用 WindowInsets 显式排版（跨 API 一致），
             这里 statusBarColor 仅作为 API<30 时的兜底 -->
    </style>

    <!-- ============ 文字样式 ============ -->
    <style name="TextAppearance.DSH.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.DSH.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.DSH.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.DSH.BodySecondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.DSH.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.DSH.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <!-- ============ 按钮样式 ============ -->
    <style name="Widget.DSH.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Widget.DSH.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="strokeColor">@color/border</item>
    </style>

    <style name="Widget.DSH.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="Widget.DSH.Button.Destructive" parent="Widget.DSH.Button.Outlined">
        <item name="android:textColor">@color/warn</item>
        <item name="strokeColor">@color/warn</item>
    </style>

    <!-- ============ 卡片样式 ============ -->
    <style name="Widget.DSH.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ============ 进度条样式 ============ -->
    <style name="Widget.DSH.ProgressBar" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackColor">@color/border</item>
        <item name="indicatorColor">@color/primary</item>
    </style>

    <!-- ============ 徽章/芯片样式 ============ -->
    <style name="Widget.DSH.Chip.Mode" parent="Widget.Material3.Chip.Suggestion">
        <item name="android:textSize">12sp</item>
        <item name="chipMinHeight">28dp</item>
        <item name="chipCornerRadius">14dp</item>
    </style>
</resources>