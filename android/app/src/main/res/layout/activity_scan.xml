<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/barcode"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 取景框叠加层 -->
    <View
        android:id="@+id/viewfinderOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/viewfinder_overlay"
        android:importantForAccessibility="no" />

    <!-- 顶部栏 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/overlay_dark"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:contentDescription="@string/scan_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:tint="@color/text_on_dark" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/scan_title"
            android:textColor="@color/text_on_dark"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 提示 / 错误横幅 -->
    <LinearLayout
        android:id="@+id/noticeBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="56dp"
        android:orientation="vertical"
        android:background="@color/overlay_notice"
        android:padding="14dp"
        android:visibility="gone"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_info"
                android:tint="@color/info"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/noticeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_on_dark"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/noticeActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- 底部操作条 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="@color/overlay_dark"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAlbum"
            style="@style/Widget.DSH.Button.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/scan_album"
            android:textColor="@color/text_on_dark"
            app:icon="@drawable/ic_album"
            app:iconGravity="textStart"
            app:iconTint="@color/text_on_dark"
            app:iconSize="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTorch"
            style="@style/Widget.DSH.Button.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/scan_torch"
            android:textColor="@color/text_on_dark"
            app:icon="@drawable/ic_flashlight"
            app:iconGravity="textStart"
            app:iconTint="@color/text_on_dark"
            app:iconSize="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManual"
            style="@style/Widget.DSH.Button.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/scan_manual"
            android:textColor="@color/text_on_dark"
            app:icon="@drawable/ic_edit"
            app:iconGravity="textStart"
            app:iconTint="@color/text_on_dark"
            app:iconSize="20dp" />
    </LinearLayout>
</FrameLayout>