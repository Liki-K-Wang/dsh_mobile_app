{
  "name": "dsh_mobile_app",
  "version": "0.4.1",
  "description": "A standard DeepSeek Harness (dsh) plugin that lets an Android phone scan a QR code and connect to the harness web GUI securely 鈥?LAN/Tailscale auto-detection, token auth, reverse proxy, and WebSocket forwarding.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/test-plugin.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "mobile",
    "android",
    "pairing",
    "qrcode",
    "remote"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  }
}
